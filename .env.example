# Copy to .env and fill in, or export these in your shell.
# Do not commit a real .env file -- it's already in .gitignore.

# Adzuna job search API (free signup: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SMTP, only needed for the `apply` command's emailed applications.
# Use an app password, not your real account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usman.ali@gmail.com
SMTP_PASSWORD=
